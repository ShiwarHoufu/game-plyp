# ===== MySQL 数据库配置（必填）=====
# 复制本文件为 server/.env 并填入你的实际配置。
# .env 已被 .gitignore 排除，请勿提交；本 .env.example 可安全提交作为模板。
DB_HOST=localhost
DB_PORT=3307
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=plyp_db
DB_CONNECTION_LIMIT=10

# ===== 可选配置 =====
# 服务器监听端口（默认 3000）
PORT=3000

# JWT 密钥：生产环境务必替换为随机长字符串
JWT_SECRET=please-change-me-to-a-long-random-string

# JWT 有效期（默认 7d）
JWT_EXPIRES_IN=7d
